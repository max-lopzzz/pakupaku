# Copy this file's variable NAMES into Render's environment-variable UI.
# Never commit real values — this file documents names only.

# ── Runtime versions ───────────────────────────
# Pins the build platform's interpreter/runtime so it matches what the
# pinned dependency versions above were actually validated against,
# instead of whatever default Render/Cloudflare Pages pick.
# Set on Render (Python) and Cloudflare Pages (Node) respectively — see
# docs/deployment.md sections 2 and 3.
# Matches this repo's dev venv exactly (`venv/bin/python3 --version`).
PYTHON_VERSION=3.8.19
# No `engines` field in pakupaku-frontend/package.json to pin from, so
# this is a reasonable current-LTS default, not independently verified
# against this exact dev environment the way PYTHON_VERSION is.
NODE_VERSION=20

# ── Database ──────────────────────────────────
# Neon connection string, using the asyncpg driver scheme.
# Get this from the Neon dashboard after creating a project — it looks
# like: postgresql+asyncpg://<user>:<password>@<host>/<dbname>
DATABASE_URL=

# ── Auth ──────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must be a fresh value for production — never reuse a local-dev SECRET_KEY.
SECRET_KEY=
# Optional — defaults to 7 days (60 * 24 * 7 minutes) if unset.
ACCESS_TOKEN_EXPIRE_MINUTES=

# ── App URLs / CORS ───────────────────────────
# The Cloudflare Pages URL once it exists, e.g. https://pakupaku.pages.dev
FRONTEND_URL=
# The Render service's own public URL, e.g. https://pakupaku-api.onrender.com
BACKEND_PUBLIC_URL=
# Comma-separated list of origins allowed to call this API.
# Should include FRONTEND_URL; localhost:3000 is already allowed by
# config.py's default even if you don't list it here.
CORS_ALLOWED_ORIGINS=

# ── Email (Resend) ─────────────────────────────
# Sent over HTTPS via Resend's API, not raw SMTP — several common hosts
# (Render's free tier included) block outbound SMTP entirely to prevent
# spam abuse; HTTPS isn't blocked. Sign up free at https://resend.com
# and get an API key from the dashboard.
RESEND_API_KEY=
# Resend's own shared sender — works immediately for any recipient, no
# domain verification needed. Switch to a verified domain's address
# later if you want mail to come from your own domain instead.
RESEND_FROM_EMAIL=PakuPaku <onboarding@resend.dev>

# ── Food data ─────────────────────────────────
# Food data is the committed data/foods.sqlite artifact, loaded into the
# `foods` table at deploy time by seed_foods.py — no food API key needed.

# ── LLM (recipe import fallback) ──────────────
# Optional — only needed if a blog page lacks schema.org/JSON-LD Recipe
# markup. Import returns a 503 for that fallback path when unset.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
